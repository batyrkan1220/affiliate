# ── Server ──────────────────────────────────────────────
PORT=3000
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 1 when the site is served over HTTPS
COOKIE_SECURE=1
# 1 behind nginx / Cloudflare / Render
TRUST_PROXY=1

# ── Teliks Supabase (partner logins, payout details and requests) ──
# Supabase → Project "teliks" → Settings → API
SUPABASE_URL=https://izaihhqaqbgxittobxtu.supabase.co
SUPABASE_ANON_KEY=
# Server only, never sent to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── TrendMe partner API ──
TRENDME_API_URL=https://trendme.kz
# Same value as TELIKS_API_SECRET in TrendMe (Render → aivideo → Environment)
TRENDME_API_SECRET=

# Minimum payout request, ₸
MIN_PAYOUT=5000

# ── Demo mode: sample data, no keys needed ──
DEMO=0
# DEMO_EMAIL=teliks.demo@example.com
# DEMO_PASSWORD=
