# ── Сервер ──────────────────────────────────────────────
PORT=3000
# Длинная случайная строка. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Поставьте 1, если сайт открывается по HTTPS
COOKIE_SECURE=0
# Поставьте 1, если сервер работает за nginx / Cloudflare / балансировщиком
TRUST_PROXY=0

# ── Сетевые ключи Offer18 (только на сервере, в браузер не передаются) ──
# ВНИМАНИЕ: эти три значения задаёт ТОЛЬКО администратор. Вебмастера их не вводят и не видят.
# Берутся в панели Offer18: Account → API (mid, api-key, secret-key).
O18_MID=
O18_API_KEY=
O18_SECRET_KEY=
O18_BASE=https://api.offer18.com
# Как отправлять тело POST-запросов в Offer18: form (application/x-www-form-urlencoded) или json.
# Если регистрация или вход возвращают ошибку, попробуйте json и запустите npm run check:offer18.
O18_BODY_FORMAT=form

# ── Поведение ───────────────────────────────────────────────
# Статус новых вебмастеров: Pending (вы подтверждаете вручную) или Approved (доступ сразу)
NEW_AFFILIATE_STATUS=Pending
# Смещение часового пояса для отчётов, в часах (Алматы / Астана = 5)
REPORT_TZ=5
# Валюта по умолчанию, если в строках Offer18 её нет
DEFAULT_CURRENCY=USD
# Размер страницы при загрузке отчёта из Offer18
REPORT_PAGE_SIZE=1000
# Максимум строк отчёта за выбранный период; при превышении интерфейс показывает предупреждение
REPORT_MAX_ROWS=100000

# Файл с заявками вебмастеров на офферы (по умолчанию data/access-requests.json в папке проекта).
# Заявки читает и отмечает администратор командой npm run requests.
# REQUESTS_FILE=./data/access-requests.json

# ── Демо-режим: поддельные данные Offer18, ключи не нужны ─────
# Вход: demo@example.com / demo1234
DEMO=0

# Регистрация вебмастеров закрыта по умолчанию. Включить: REGISTRATION_OPEN=1
REGISTRATION_OPEN=0

# Вход в демо-режиме (DEMO=1). Задайте свои значения, чтобы поменять пароль без правки кода
# DEMO_EMAIL=teliks.demo@example.com
# DEMO_PASSWORD=
