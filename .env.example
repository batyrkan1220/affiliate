# ── Server ──────────────────────────────────────────────
PORT=3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
# Set to 1 when running behind nginx / Cloudflare / a load balancer
TRUST_PROXY=0

# ── Offer18 NETWORK credentials (server-side only, never sent to the browser) ──
# Offer18 panel → Account → API. These are the network-level keys (mid, api-key, secret-key).
O18_MID=
O18_API_KEY=
O18_SECRET_KEY=
O18_BASE=https://api.offer18.com
# How POST bodies are sent to Offer18: form (application/x-www-form-urlencoded) or json
O18_BODY_FORMAT=form

# ── Behaviour ───────────────────────────────────────────────
# Status given to newly registered webmasters: Pending (you approve manually) or Approved (instant access)
NEW_AFFILIATE_STATUS=Pending
# Report timezone offset in hours (Almaty / Astana = 5)
REPORT_TZ=5
# Currency shown if Offer18 rows carry none
DEFAULT_CURRENCY=USD
REPORT_PAGE_SIZE=1000
REPORT_MAX_ROWS=100000

# ── Demo mode: fake Offer18 data, no credentials needed ─────
# Login: demo@example.com / demo1234
DEMO=0
